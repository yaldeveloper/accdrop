# Database (required). Any Postgres: Neon / Vercel Postgres, or a server inside Iran. Tables are created automatically.
DATABASE_URL=postgres://user:pass@host:5432/accdrop

# Random long string used to hash login codes and sessions (required in production).
AUTH_SECRET=change-me-to-a-long-random-string

# Mobiles that can open /admin, comma separated.
ADMIN_MOBILES=09120000000

# Public address of the site, used for the payment callback.
SITE_URL=https://accdrop.ir

# Kavenegar SMS. Without the key the site runs in demo mode: no SMS, login code is always 12345.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=accdrop-otp
# Optional: SMS to the customer when an order is ready (template with %token = order code).
KAVENEGAR_ORDER_TEMPLATE=

# Zarinpal. Without a merchant id a built-in test gateway is used.
ZARINPAL_MERCHANT=
# 1 = use the Zarinpal sandbox
ZARINPAL_SANDBOX=

# Crypto payments (NOWPayments). Without an API key, crypto orders use the built-in test gateway.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Fallback Toman price of one USDT, used only when the live rate (Nobitex, Wallex) cannot be fetched.
CRYPTO_RATE_TOMAN=105000

# Installments with SnappPay (اسنپ‌پی). Values come from SnappPay after signing a merchant contract.
SNAPPPAY_BASE_URL=
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=

# Official invoices: seller details printed on every invoice, and the VAT percent included in prices.
SELLER_NAME=
SELLER_NATIONAL_ID=
SELLER_ECONOMIC_CODE=
SELLER_REG_NO=
SELLER_POSTAL=
SELLER_ADDRESS=
SELLER_PHONE=
VAT_PERCENT=10

# Optional Kavenegar template for "your دنگ group is complete" (token = group code).
KAVENEGAR_SPLIT_TEMPLATE=

# Insight Store reseller API (auto-buys redeem codes for products connected on /admin/supplier). Keep the key only here.
INSIGHT_API_KEY=
# 1 = test orders (TEST- codes, nothing charged)
INSIGHT_TEST_MODE=
